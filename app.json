{
  "expo": {
    "name": "pdapp",
    "slug": "appchurch",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon-pda-centro.png",
    "scheme": "appchurch",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "com.ampiup.appchurch",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ampiup.appchurch",
      "adaptiveIcon": {
        "backgroundColor": "#5A7299",
        "foregroundImage": "./assets/android-icon-pda-centro.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55d2d878-e9cc-4cd4-a73c-c6241664e274"
      }
    },
    "owner": "ampiup",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/55d2d878-e9cc-4cd4-a73c-c6241664e274"
    }
  }
}
