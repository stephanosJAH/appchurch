# npm intenta resolver el peer opcional react-native-windows de
# @react-native-community/datetimepicker, que solo llega hasta RN 0.84 y choca
# con la 0.86 del SDK 57. No es una incompatibilidad real (ese peer no aplica a
# Android/iOS), pero sin esto todo `npm install` / `npx expo install` falla.
legacy-peer-deps=true
